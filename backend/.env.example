APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long

# Business Details
BUSINESS_NAME="Gujjar Petrolium Kot Gujjran"
BUSINESS_NAME_UR="گجر پیٹرولیم، کوٹ گجراں"
MANAGER_NAME="Muhammad Asad"
CURRENCY=PKR
TIMEZONE=Asia/Karachi
DEFAULT_LANGUAGE=ur

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth (Phase 5)
ADMIN_SESSION_SECRET=dev-session-secret-placeholder-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Google Sheets (Phase 2)
GOOGLE_SHEETS_SPREADSHEET_ID=placeholder_spreadsheet_id_abc123
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
GOOGLE_SHEETS_USE_MOCK=true

# Meta WhatsApp Cloud API (Phase 4)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id_12345
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_business_account_id_67890
WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_webhook_verification_token
META_APP_SECRET=placeholder_meta_app_secret
MESSAGING_MODE=DRY_RUN
WHATSAPP_REMINDER_TEMPLATE_NAME=payment_reminder_v1
WHATSAPP_REMINDER_TEMPLATE_LANG=ur
WHATSAPP_COOLDOWN_DAYS=3

# Gemini AI (Optional / Phase 5)
GEMINI_API_KEY=placeholder_gemini_api_key
