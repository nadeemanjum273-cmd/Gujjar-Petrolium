# ==============================================================================
# Gujjar Petrolium Kot Gujjran — Environment Configuration Template
# ==============================================================================
# NOTICE: Copy this file to `.env` for local development. Never commit real credentials!

# ------------------------------------------------------------------------------
# CORE APPLICATION CONFIGURATION (Phase 1 - Required)
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long

# Business Details
BUSINESS_NAME="Gujjar Petrolium Kot Gujjran"
BUSINESS_NAME_UR="گجر پیٹرولیم، کوٹ گجراں"
MANAGER_NAME="Muhammad Asad"
CURRENCY=PKR
TIMEZONE=Asia/Karachi
DEFAULT_LANGUAGE=ur

# CORS Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (Phase 5 - Reserved)
# ------------------------------------------------------------------------------
ADMIN_SESSION_SECRET=dev-session-secret-placeholder-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# GOOGLE SHEETS API INTEGRATION (Phase 2 - Reserved)
# ------------------------------------------------------------------------------
# Google Spreadsheet ID (from Google Sheets URL)
GOOGLE_SHEETS_SPREADSHEET_ID=placeholder_spreadsheet_id_abc123
# Path to service account json key file OR base64-encoded string
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
# Fallback to local in-memory/mock store when testing without live Google credentials
GOOGLE_SHEETS_USE_MOCK=true

# ------------------------------------------------------------------------------
# META WHATSAPP CLOUD API (Phase 4 - Reserved)
# ------------------------------------------------------------------------------
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id_12345
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_business_account_id_67890
WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_webhook_verification_token
META_APP_SECRET=placeholder_meta_app_secret
# Messaging Mode: DRY_RUN (default safe mode, no external HTTP calls) or LIVE
MESSAGING_MODE=DRY_RUN

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI (Optional / Phase 5 - Reserved)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=placeholder_gemini_api_key
